<IfModule mod_rewrite.c>
  <IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
  </IfModule>

  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https://*.wallyatkins.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

    <FilesMatch "\.(?:css|js|mjs|svg|png|jpg|jpeg|gif|webp|avif|ico|woff2?|wasm|swf)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Service Worker must NOT be cached indefinitely
    <Files "sw.js">
      Header set Cache-Control "no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
      Header set Expires "0"
      Header set Service-Worker-Allowed "/"
    </Files>

    # Manifest file caching
    <FilesMatch "\.(?:webmanifest|json)$">
      Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
  </IfModule>

  # Prevent directory indexing
  Options -Indexes

  # Deny access to sensitive files and hidden dotfiles
  <FilesMatch "(?:^\.|\.env.*|error_log|composer\.(?:json|lock)|package(?:-lock)?\.json|\.sql|\.md|\.log)$">
    Require all denied
  </FilesMatch>

  RewriteEngine On
  
  # Allow access to backend endpoints
  RewriteRule ^(pine|irc|matomo)\.php$ - [L]

  # Allow access to assets
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>
